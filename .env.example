# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Database (PostgreSQL - `docker compose up -d` starts one on port 5432)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/venice_saas?schema=public"

# -----------------------------------------------------------------------------
# Email (Postmark)
# -----------------------------------------------------------------------------
SMTP_FROM=
POSTMARK_API_TOKEN=
POSTMARK_SIGN_IN_TEMPLATE=
POSTMARK_ACTIVATION_TEMPLATE=

# -----------------------------------------------------------------------------
# Payments (PayPhone - https://appdeveloper.payphonetodoesposible.com)
# -----------------------------------------------------------------------------
PAYPHONE_AUTH_TOKEN=
# Optional: store GUID (Configuración > Tiendas). If omitted, PayPhone uses the app's default store.
PAYPHONE_STORE_ID=

# -----------------------------------------------------------------------------
# AI (Venice.ai - https://venice.ai/settings/api)
# -----------------------------------------------------------------------------
VENICE_API_KEY=
# Optional overrides. See https://docs.venice.ai/overview/models
VENICE_MODEL=llama-3.3-70b
VENICE_IMAGE_MODEL=fluently-xl